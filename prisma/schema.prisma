generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  zh
  en
}

enum ProductPlatform {
  MT4
  MT5
  BOTH
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AdNetwork {
  ADSENSE
  CUSTOM
  DISABLED
}

enum AdPlacement {
  DOWNLOAD_PAGE_MAIN
  HOME_SIDEBAR
  PRODUCT_DETAIL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  sortOrder    Int                   @default(0)
  status       PublishStatus         @default(PUBLISHED)
  products     Product[]
  translations CategoryTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      Locale
  name        String
  description String?
  seoTitle    String?
  seoDesc     String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id            String               @id @default(cuid())
  categoryId    String?
  slug          String               @unique
  platform      ProductPlatform
  symbol        String?
  timeframes    String[]
  status        PublishStatus        @default(DRAFT)
  isPopular     Boolean              @default(false)
  rating        Decimal              @default(5.0) @db.Decimal(2, 1)
  originalPrice Decimal?             @db.Decimal(10, 2)
  freePrice     Decimal?             @db.Decimal(10, 2)
  downloadCount Int                  @default(0)
  publishedAt   DateTime?
  category      Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations  ProductTranslation[]
  images        ProductImage[]
  files         ProductFile[]
  downloads     DownloadEvent[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  locale      Locale
  title       String
  excerpt     String?
  description String?
  seoTitle    String?
  seoDesc     String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ProductFile {
  id        String          @id @default(cuid())
  productId String
  version   String
  fileName  String
  fileUrl   String
  fileType  String
  status    PublishStatus   @default(PUBLISHED)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloads DownloadEvent[]
  createdAt DateTime        @default(now())
}

model AdSlot {
  id               String      @id @default(cuid())
  name             String
  placement        AdPlacement
  network          AdNetwork   @default(ADSENSE)
  desktopSize      String      @default("RESPONSIVE")
  mobileSize       String      @default("RESPONSIVE")
  desktopCode      String?
  mobileCode       String?
  fallbackCode     String?
  countdownSeconds Int         @default(5)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model DonationSetting {
  id            String   @id @default(cuid())
  titleZh       String
  titleEn       String
  descriptionZh String?
  descriptionEn String?
  qr1Network    String
  qr1Address    String
  qr1ImageUrl   String?
  qr2Network    String?
  qr2Address    String?
  qr2ImageUrl   String?
  updatedAt     DateTime @updatedAt
}

model VisitEvent {
  id        String   @id @default(cuid())
  path      String
  locale    Locale
  country   String?
  referrer  String?
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())
}

model DownloadEvent {
  id        String       @id @default(cuid())
  productId String
  fileId    String?
  locale    Locale
  country   String?
  ipHash    String?
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  file      ProductFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
}

model SeoSetting {
  id          String   @id @default(cuid())
  path        String
  locale      Locale
  title       String
  description String?
  canonical   String?
  ogImageUrl  String?
  updatedAt   DateTime @updatedAt

  @@unique([path, locale])
}

model GuestMessage {
  id        String        @id @default(cuid())
  locale    Locale        @default(zh)
  name      String
  email     String?
  content   String
  reply     String?
  status    PublishStatus @default(DRAFT)
  country   String?
  userAgent String?
  ipHash    String?
  repliedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
